---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="お問い合わせ / 聯絡我們 | Unippon"
  description="Unippon 日本情報サイトへのお問い合わせ・ご意見・ビジネスに関するご相談はこちらから。"
>
  <div class="static-page">
    <h1>お問い合わせ (Contact Us)</h1>
    <div class="content">
      <p class="intro-greeting">Unippon へのご意見・お問い合わせをお待ちしております。</p>
      <p>日本文化、観光情報、取材依頼やコラボレーションなど、お気軽にお送りください。</p>

      <form id="contact-form" class="universal-contact-form">
        <input type="hidden" name="site" value="unippon.com" />
        <input type="hidden" name="type" value="general" />

        <div class="form-group">
          <label for="name">お名前 / 貴社名 *</label>
          <input type="text" id="name" name="name" required placeholder="お名前を入力してください" />
        </div>

        <div class="form-group">
          <label for="email">メールアドレス *</label>
          <input type="email" id="email" name="email" required placeholder="your.email@example.com" />
        </div>

        <div class="form-group">
          <label for="subject">件名 *</label>
          <input type="text" id="subject" name="subject" required placeholder="件名を入力してください" />
        </div>

        <div class="form-group">
          <label for="message">お問い合わせ内容 *</label>
          <textarea id="message" name="message" rows="6" required placeholder="お問い合わせ内容を入力してください..."></textarea>
        </div>

        <button type="submit" id="submit-btn" class="submit-button">
          ✉️ 送信する
        </button>

        <div id="form-response" class="response-message"></div>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const responseElem = document.getElementById('form-response');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = '⏳ 送信中...';
        if (responseElem) responseElem.style.display = 'none';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('https://mountos.com/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await res.json();

          if (responseElem) {
            responseElem.style.display = 'block';
            if (result.success) {
              responseElem.className = 'response-message success';
              responseElem.textContent = '✅ お問い合わせを受け付けました。ご送信ありがとうございます！';
              form.reset();
            } else {
              responseElem.className = 'response-message error';
              responseElem.textContent = '❌ ' + (result.error || '送信に失敗しました。');
            }
          }
        } catch (err) {
          if (responseElem) {
            responseElem.style.display = 'block';
            responseElem.className = 'response-message error';
            responseElem.textContent = '❌ ネットワークエラーが発生しました。';
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = '✉️ 送信する';
        }
      });
    }
  });
</script>

<style>
  .static-page {
    max-width: 680px;
    margin: auto;
    padding: 2rem 1rem;
  }
  .static-page h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .intro-greeting {
    font-size: 1.2rem;
    font-weight: bold;
    text-align: center;
    margin-bottom: 1rem;
  }
  .content p {
    text-align: center;
    color: var(--color-text-muted, #666);
    margin-bottom: 2rem;
  }
  .universal-contact-form {
    background: var(--color-bg-offset, #fcfcfc);
    border: 1px solid var(--color-border, #eee);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.8rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    box-sizing: border-box;
  }
  .submit-button {
    width: 100%;
    background-color: var(--color-primary, #111);
    color: #fff;
    border: none;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.9rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .submit-button:hover {
    opacity: 0.9;
  }
  .response-message {
    margin-top: 1.25rem;
    padding: 0.9rem;
    border-radius: 8px;
    text-align: center;
    font-weight: 600;
    display: none;
  }
  .response-message.success {
    background-color: #e6f4ea;
    color: #137333;
  }
  .response-message.error {
    background-color: #fce8e6;
    color: #c5221f;
  }
</style>
